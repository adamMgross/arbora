---
import Breadcrumb from '../components/Breadcrumb.astro';
import type { Crumb } from '../components/Breadcrumb.astro';
import CanonNav from '../components/CanonNav.astro';
import CanonToc from '../components/CanonToc.astro';
import type { Pager } from '../components/CanonNav.astro';
import type { ComponentProps } from 'astro/types';
import type { TocItem } from '../lib/toc';
import ProseLayout from './ProseLayout.astro';

interface Props extends ComponentProps<typeof ProseLayout> {
  trail: Crumb[];
  pager: Pager;
  toc?: TocItem[];
}

const { trail, pager, toc, ...prose } = Astro.props;
---

<ProseLayout {...prose}>
    <Breadcrumb trail={trail} />
    {toc && <CanonToc items={toc} />}
    <slot />
    <CanonNav {...pager} />
</ProseLayout>
