---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { canonHref } from '../lib/canon';

const today = (await getEntry('today', 'today'))!.data;
const pools = {
  seasonGreetings: today.seasonGreetings,
  morningInvocations: today.morningInvocations,
  readings: today.readings.map(({ text, source, tradition }) => ({
    text,
    source,
    page: canonHref(tradition.id),
    label: today.traditionLabels[tradition.id],
  })),
  eveningReflections: today.eveningReflections,
};
const poolsJson = JSON.stringify(pools).replace(/</g, '\\u003c');
---

<Base
  title="Today — Arbora"
  description="Your daily touchpoint — a morning invocation, a reading, and an evening reflection."
  ogTitle="Today — Arbora"
  ogDescription="Your daily touchpoint — a morning invocation, a reading, and an evening reflection."
>
    <header class="page-header" id="main">
        <h1>Today</h1>
        <p id="season-greeting"></p>
    </header>

    <noscript>
        <div class="page-content">
            <div class="container narrow">
                <h2>Morning</h2>
                <div class="invocation">
                    <em>I woke today because others endured before me — through crossings I cannot imagine, in languages I no longer speak. I carry their survival in my body. This morning, with this tea, I remember them.</em>
                </div>
                <h2>A Reading</h2>
                <blockquote>To every thing there is a season, and a time to every purpose under the heaven: a time to be born, and a time to die; a time to plant, and a time to pluck up that which is planted.<br>— Ecclesiastes 3:1–2</blockquote>
                <h2>Evening</h2>
                <div class="invocation">
                    <em>What did I receive today that I did not earn? Let me name one gift before I sleep.</em>
                </div>
                <p style="font-family: var(--font-ui); font-size: 0.8rem; color: var(--branch); margin-top: var(--space-lg); text-align: center;">Enable JavaScript for daily rotating invocations, readings, and reflections.</p>
            </div>
        </div>
    </noscript>

    <div class="page-content">
        <div class="container narrow">

            <h2 id="morning-heading">Morning <button class="shuffle-btn" aria-label="Show a different invocation" data-section="morning">another</button></h2>
            <div class="invocation" id="morning-invocation">
                <em id="morning-text"></em>
            </div>

            <h2 id="reading-heading">A Reading <button class="shuffle-btn" aria-label="Show a different reading" data-section="reading">another</button></h2>
            <blockquote id="reading-text"></blockquote>
            <div class="reading-footer">
                <p class="reading-source" id="reading-source"></p>
                <div class="reading-actions">
                    <a href="#" id="reading-canon-link" class="reading-tradition-link"></a>
                    <button class="reading-bookmark-btn" id="reading-bookmark" aria-label="Save this reading" data-saved="false">save</button>
                </div>
            </div>

            <h2 id="evening-heading">Evening <button class="shuffle-btn" aria-label="Show a different reflection" data-section="evening">another</button></h2>
            <div class="invocation" id="evening-invocation">
                <em id="evening-text"></em>
            </div>

            <div id="saved-readings-section" class="saved-section">
                <h2 class="saved-heading">Saved</h2>
                <div id="saved-readings-list"></div>
                <button id="clear-saved" class="clear-saved-btn">clear all</button>
            </div>

        </div>
    </div>
<script is:inline type="application/json" slot="scripts" set:html={poolsJson} />
<script is:inline slot="scripts">
    (function() {
        // ── Season & time detection ──
        var now = new Date();
        var month = now.getMonth(); // 0-indexed
        var hour = now.getHours();
        var dayOfYear = Math.floor((now - new Date(now.getFullYear(), 0, 0)) / 86400000);

        var season;
        if (month >= 2 && month <= 4) season = 'spring';
        else if (month >= 5 && month <= 7) season = 'summer';
        else if (month >= 8 && month <= 10) season = 'autumn';
        else season = 'winter';

        var timeOfDay;
        if (hour < 12) timeOfDay = 'morning';
        else if (hour < 18) timeOfDay = 'afternoon';
        else timeOfDay = 'evening';

        // ── Season greetings ──
        var data = JSON.parse(document.querySelector('script[type="application/json"]').textContent);
        var seasonGreetings = data.seasonGreetings;

        document.getElementById('season-greeting').textContent = seasonGreetings[season];

        // ── Morning invocations (12, cycling) ──
        var morningInvocations = data.morningInvocations;

        // ── Canon readings (90, cycling) ──
        // Ordered to distribute traditions evenly across the cycle.
        var canonReadings = data.readings;





        // ── Evening reflections (16, cycling) ──
        var eveningReflections = data.eveningReflections;

        // ── Select today's content ──
        var morningIndex = dayOfYear % morningInvocations.length;
        var readingIndex = dayOfYear % canonReadings.length;
        var eveningIndex = dayOfYear % eveningReflections.length;

        document.getElementById('morning-text').textContent = morningInvocations[morningIndex];
        document.getElementById('reading-text').textContent = canonReadings[readingIndex].text;
        document.getElementById('reading-source').textContent = '\u2014 ' + canonReadings[readingIndex].source;
        document.getElementById('evening-text').textContent = eveningReflections[eveningIndex];

        // ── Canon link ──
        function setCanonLink(idx) {
            var page = canonReadings[idx].page;
            var link = document.getElementById('reading-canon-link');
            if (page) {
                link.href = page;
                link.textContent = 'Explore ' + (canonReadings[idx].label || 'this tradition') + ' \u2192';
                link.style.display = '';
            } else {
                link.style.display = 'none';
            }
        }
        setCanonLink(readingIndex);

        // ── Bookmarks ──
        var SAVED_KEY = 'arbora-saved-readings';

        function getSaved() {
            try { return JSON.parse(localStorage.getItem(SAVED_KEY)) || []; }
            catch(e) { return []; }
        }
        function setSaved(arr) {
            try { localStorage.setItem(SAVED_KEY, JSON.stringify(arr)); } catch(e) {}
        }
        function isSaved(text, source) {
            return getSaved().some(function(r) { return r.source === source && r.text === text; });
        }

        function updateBookmarkBtn() {
            var r = canonReadings[readingIndex];
            var btn = document.getElementById('reading-bookmark');
            var saved = isSaved(r.text, r.source);
            btn.textContent = saved ? 'saved \u2665' : 'save';
            btn.dataset.saved = saved ? 'true' : 'false';
        }
        updateBookmarkBtn();

        function renderSaved() {
            var saved = getSaved();
            var section = document.getElementById('saved-readings-section');
            var list = document.getElementById('saved-readings-list');
            if (saved.length === 0) {
                section.classList.remove('is-visible');
                return;
            }
            section.classList.add('is-visible');
            list.innerHTML = '';
            saved.forEach(function(r, i) {
                var item = document.createElement('div');
                item.className = 'saved-item';
                var q = document.createElement('p');
                q.className = 'saved-item-text';
                q.textContent = r.text;
                var src = document.createElement('p');
                src.className = 'saved-item-source';
                src.textContent = '\u2014 ' + r.source;
                var removeBtn = document.createElement('button');
                removeBtn.className = 'saved-remove-btn';
                removeBtn.textContent = 'remove';
                removeBtn.addEventListener('click', function() {
                    var arr = getSaved();
                    arr.splice(i, 1);
                    setSaved(arr);
                    renderSaved();
                    updateBookmarkBtn();
                });
                item.appendChild(q);
                item.appendChild(src);
                item.appendChild(removeBtn);
                list.appendChild(item);
            });
        }
        renderSaved();

        document.getElementById('reading-bookmark').addEventListener('click', function() {
            var r = canonReadings[readingIndex];
            var arr = getSaved();
            if (isSaved(r.text, r.source)) {
                arr = arr.filter(function(x) { return !(x.source === r.source && x.text === r.text); });
            } else {
                arr.push({ text: r.text, source: r.source });
            }
            setSaved(arr);
            updateBookmarkBtn();
            renderSaved();
        });

        document.getElementById('clear-saved').addEventListener('click', function() {
            setSaved([]);
            renderSaved();
            updateBookmarkBtn();
        });

        // ── "now" indicator ──
        // Use insertAdjacentHTML so existing button DOM nodes are not destroyed.
        var nowLabel = '<span style="font-family: var(--font-ui); font-size: 0.65rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--lichen); vertical-align: middle; margin-left: 0.5em;">now</span>';

        if (timeOfDay === 'morning') {
            document.getElementById('morning-heading').insertAdjacentHTML('beforeend', nowLabel);
        } else if (timeOfDay === 'afternoon') {
            document.getElementById('reading-heading').insertAdjacentHTML('beforeend', nowLabel);
        } else {
            document.getElementById('evening-heading').insertAdjacentHTML('beforeend', nowLabel);
        }

        // ── Shuffle buttons ──
        function fadeSwap(el, fn) {
            el.style.transition = 'opacity 0.25s';
            el.style.opacity = '0';
            setTimeout(function() {
                fn();
                el.style.opacity = '1';
            }, 200);
        }

        document.querySelectorAll('.shuffle-btn').forEach(function(btn) {
            btn.addEventListener('click', function() {
                var section = this.dataset.section;
                var arr, currentIdx;

                if (section === 'morning') {
                    arr = morningInvocations;
                    currentIdx = morningIndex;
                } else if (section === 'reading') {
                    arr = canonReadings;
                    currentIdx = readingIndex;
                } else {
                    arr = eveningReflections;
                    currentIdx = eveningIndex;
                }

                var newIdx;
                do {
                    newIdx = Math.floor(Math.random() * arr.length);
                } while (newIdx === currentIdx && arr.length > 1);

                if (section === 'morning') {
                    morningIndex = newIdx;
                    var el = document.getElementById('morning-text');
                    fadeSwap(el.parentElement, function() {
                        el.textContent = arr[newIdx];
                    });
                } else if (section === 'reading') {
                    readingIndex = newIdx;
                    var readEl = document.getElementById('reading-text');
                    var srcEl = document.getElementById('reading-source');
                    var canonLinkEl = document.getElementById('reading-canon-link');
                    readEl.style.transition = 'opacity 0.25s';
                    srcEl.style.transition = 'opacity 0.25s';
                    canonLinkEl.style.transition = 'opacity 0.25s';
                    readEl.style.opacity = '0';
                    srcEl.style.opacity = '0';
                    canonLinkEl.style.opacity = '0';
                    setTimeout(function() {
                        readEl.textContent = arr[newIdx].text;
                        srcEl.textContent = '\u2014 ' + arr[newIdx].source;
                        setCanonLink(newIdx);
                        updateBookmarkBtn();
                        readEl.style.opacity = '1';
                        srcEl.style.opacity = '1';
                        canonLinkEl.style.opacity = '1';
                    }, 200);
                } else {
                    eveningIndex = newIdx;
                    var eveEl = document.getElementById('evening-text');
                    fadeSwap(eveEl.parentElement, function() {
                        eveEl.textContent = arr[newIdx];
                    });
                }
            });
        });

    })();
    </script>
</Base>
