---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { canonHref } from '../lib/canon';
import type { TodayPools } from '../lib/today-pools';

const today = (await getEntry('today', 'today'))!.data;
const pools: TodayPools = {
  seasonGreetings: today.seasonGreetings,
  morningInvocations: today.morningInvocations,
  readings: today.readings.map(({ text, source, tradition }) => ({
    text,
    source,
    page: canonHref(tradition.id),
    label: today.traditionLabels[tradition.id],
  })),
  eveningReflections: today.eveningReflections,
};
const poolsJson = JSON.stringify(pools).replace(/</g, '\\u003c');
---

<Base
  title="Today — Arbora"
  description="Your daily touchpoint — a morning invocation, a reading, and an evening reflection."
  ogTitle="Today — Arbora"
  ogDescription="Your daily touchpoint — a morning invocation, a reading, and an evening reflection."
>
    <header class="page-header" id="main">
        <h1>Today</h1>
        <p id="season-greeting"></p>
    </header>

    <noscript>
        <div class="page-content">
            <div class="container narrow">
                <h2>Morning</h2>
                <div class="invocation">
                    <em>I woke today because others endured before me — through crossings I cannot imagine, in languages I no longer speak. I carry their survival in my body. This morning, with this tea, I remember them.</em>
                </div>
                <h2>A Reading</h2>
                <blockquote>To every thing there is a season, and a time to every purpose under the heaven: a time to be born, and a time to die; a time to plant, and a time to pluck up that which is planted.<br>— Ecclesiastes 3:1–2</blockquote>
                <h2>Evening</h2>
                <div class="invocation">
                    <em>What did I receive today that I did not earn? Let me name one gift before I sleep.</em>
                </div>
                <p style="font-family: var(--font-ui); font-size: 0.8rem; color: var(--branch); margin-top: var(--space-lg); text-align: center;">Enable JavaScript for daily rotating invocations, readings, and reflections.</p>
            </div>
        </div>
    </noscript>

    <div class="page-content">
        <div class="container narrow">

            <h2 id="morning-heading">Morning <button class="shuffle-btn" aria-label="Show a different invocation" data-section="morning">another</button></h2>
            <div class="invocation" id="morning-invocation">
                <em id="morning-text"></em>
            </div>

            <h2 id="reading-heading">A Reading <button class="shuffle-btn" aria-label="Show a different reading" data-section="reading">another</button></h2>
            <blockquote id="reading-text"></blockquote>
            <div class="reading-footer">
                <p class="reading-source" id="reading-source"></p>
                <div class="reading-actions">
                    <a href="#" id="reading-canon-link" class="reading-tradition-link"></a>
                    <button class="reading-bookmark-btn" id="reading-bookmark" aria-label="Save this reading" data-saved="false">save</button>
                </div>
            </div>

            <h2 id="evening-heading">Evening <button class="shuffle-btn" aria-label="Show a different reflection" data-section="evening">another</button></h2>
            <div class="invocation" id="evening-invocation">
                <em id="evening-text"></em>
            </div>

            <div id="saved-readings-section" class="saved-section">
                <h2 class="saved-heading">Saved</h2>
                <div id="saved-readings-list"></div>
                <button id="clear-saved" class="clear-saved-btn">clear all</button>
            </div>

        </div>
    </div>
<script is:inline type="application/json" slot="scripts" set:html={poolsJson} />
</Base>
