---
import DecoColumn from '../components/decor/DecoColumn.astro';
import HeroGeometry from '../components/decor/HeroGeometry.astro';
import HeroTree from '../components/decor/HeroTree.astro';
import MetaBackdrop from '../components/decor/MetaBackdrop.astro';
import OrnamentDiamond from '../components/decor/OrnamentDiamond.astro';
import OrnamentRings from '../components/decor/OrnamentRings.astro';
import PatternCanopy from '../components/decor/PatternCanopy.astro';
import PatternNetwork from '../components/decor/PatternNetwork.astro';
import PatternRoots from '../components/decor/PatternRoots.astro';
import SectionSeparator from '../components/SectionSeparator.astro';
import Base from '../layouts/Base.astro';
---

<Base
  title="Arbora"
  description="Arbora — a personal syncretic religion rooted in the imagery of trees, drawing from many traditions to explore how we grow, connect, and find meaning."
  ogTitle="Arbora"
  ogDescription="A personal syncretic religion rooted in the imagery of trees, drawing from many traditions to explore how we grow, connect, and find meaning."
>
    <!-- ═══════════════════════════════════════════
         HERO
         ═══════════════════════════════════════════ -->
    <main id="main">
    <header class="hero">

        <!-- Sacred geometry mandala — flower of life + concentric rings -->
        <HeroGeometry />

        <!-- Tree illustration — branches and roots -->
        <HeroTree />

        <div class="hero-inner">
            <p class="hero-super">A religion of</p>
            <h1 class="hero-title">Interconnection, Deep Time<br>& Presence</h1>
            <div class="hero-line"></div>
            <p class="hero-sub">We seek wisdom from all human traditions that illuminate our relationship to the living world, to our ancestors, and to the vast unfolding of time.</p>
        </div>

        <div class="hero-scroll-hint" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
        </div>
    </header>

    <!-- Separator: Hero → Preamble -->
    <SectionSeparator from="parchment" to="cream" tall path="M0,0 L1440,0 L1440,25 C1200,65 960,8 720,38 C480,68 240,12 0,48 Z" />

    <!-- ═══════════════════════════════════════════
         PREAMBLE
         ═══════════════════════════════════════════ -->
    <section class="section preamble">
        <div class="container narrow">
            <p class="lead">Arbora is a syncretic, non-theistic religion built on the humble curation of humanity's deepest wisdom. It draws from Buddhism, Daoism, Stoicism, Judaism, indigenous traditions from every continent, classical philosophy, Sufism, Christian mysticism, and the empirical sciences, weaving their most resonant threads into a coherent practice for those who find the sacred in trees, in silence, in community, and in the long arc of geological time.</p>
            <p>The canon is never closed. Any tradition that speaks to interconnection, presence, reciprocity, and wonder is welcome here.</p>
        </div>
    </section>

    <!-- Ornamental flourish divider -->
    <OrnamentDiamond />

    <!-- Separator: Preamble → Values -->
    <SectionSeparator from="cream" to="parchment" path="M0,0 L1440,0 L1440,18 C1320,45 1080,5 840,30 C600,55 360,10 0,35 Z" />

    <!-- ═══════════════════════════════════════════
         CORE VALUES
         ═══════════════════════════════════════════ -->
    <section class="section values" id="values">
        <!-- Background: large branching canopy pattern -->
        <div class="section-bg" aria-hidden="true">
            <PatternCanopy />
        </div>

        <div class="container">
            <h2 class="section-title">The Root</h2>
            <p class="section-subtitle">Eight values from which everything grows</p>

            <div class="values-grid">
                <div class="value-card">
                    <span class="value-num">I</span>
                    <h3>Interconnection</h3>
                    <p>All things are related. Humans are embedded in ecological, temporal, and ancestral systems — woven into them completely.</p>
                </div>
                <div class="value-card">
                    <span class="value-num">II</span>
                    <h3>Deep Time</h3>
                    <p>Awe for geological processes, evolution, forests, mountains, the slow work of millions of years.</p>
                </div>
                <div class="value-card">
                    <span class="value-num">III</span>
                    <h3>Ancestral Consciousness</h3>
                    <p>Honoring those who came before. Carrying forward their stories, their survival, their wisdom.</p>
                </div>
                <div class="value-card">
                    <span class="value-num">IV</span>
                    <h3>Presence & Clarity</h3>
                    <p>Silence, meditation, embodied awareness. Freedom from constant input and distraction.</p>
                </div>
                <div class="value-card">
                    <span class="value-num">V</span>
                    <h3>Reciprocity</h3>
                    <p>Mutual obligation, freely chosen. What you take, you give back.</p>
                </div>
                <div class="value-card">
                    <span class="value-num">VI</span>
                    <h3>Intellectual Rigor</h3>
                    <p>Study, debate, curiosity. Never accepting simplified narratives. Seeking truth even when uncomfortable.</p>
                </div>
                <div class="value-card">
                    <span class="value-num">VII</span>
                    <h3>Community & Gathering</h3>
                    <p>Breaking bread together, rituals with others, human connection as sacred. Show up for your people.</p>
                </div>
                <div class="value-card">
                    <span class="value-num">VIII</span>
                    <h3>Wonder</h3>
                    <p>Recognition that we are small. Mystery is a reality to inhabit, and inhabiting it is enough.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Separator: Values → Principles -->
    <SectionSeparator from="parchment" to="cream" path="M0,0 L1440,0 L1440,22 C1260,48 1080,8 900,32 C720,56 540,12 360,36 C180,52 60,18 0,28 Z" />

    <!-- ═══════════════════════════════════════════
         EIGHT PRINCIPLES
         ═══════════════════════════════════════════ -->
    <section class="section principles" id="principles">
        <!-- Classical column decorations -->
        <DecoColumn side="left" entasis />
        <DecoColumn side="right" />

        <div class="container narrow">
            <h2 class="section-title">The Eight Principles</h2>
            <p class="section-subtitle">Draft — to be expanded with source texts, invocations, and practice guidance</p>

            <ol class="principles-list">
                <li>
                    <strong>Honor the Web of Life</strong>
                    <span>All beings are interconnected. Your actions ripple outward through systems you cannot see.</span>
                </li>
                <li>
                    <strong>Dwell in Deep Time</strong>
                    <span>You are a temporary expression of ancient processes. Think in scales of mountains and forests.</span>
                </li>
                <li>
                    <strong>Seek Clarity Through Practice</strong>
                    <span>Meditation, movement, silence, and study sharpen your perception and reduce your suffering.</span>
                </li>
                <li>
                    <strong>Give and Receive in Reciprocity</strong>
                    <span>Nothing is owed; everything is a gift. Take only what you need. Give back more than you take.</span>
                </li>
                <li>
                    <strong>Remember Your Ancestors</strong>
                    <span>You carry forward the survival, wisdom, and stories of those who came before. Honor them by living fully.</span>
                </li>
                <li>
                    <strong>Gather and Break Bread</strong>
                    <span>Community, hospitality, and presence with others are sacred. Show up for your people.</span>
                </li>
                <li>
                    <strong>Question Everything; Revere the Search</strong>
                    <span>Study, debate, and intellectual honesty are spiritual acts. Never accept simplified narratives.</span>
                </li>
                <li>
                    <strong>Stand Humbly Before the Unknowable</strong>
                    <span>You are small. Mystery is a reality to inhabit, and inhabiting it is enough. Wonder is enough.</span>
                </li>
            </ol>
        </div>
    </section>

    <!-- Ornamental flourish divider -->
    <OrnamentRings />

    <!-- Separator: Principles → Traditions -->
    <SectionSeparator from="cream" to="parchment" path="M0,0 L1440,0 L1440,20 C1200,50 960,5 720,30 C480,55 240,10 0,40 Z" />

    <!-- ═══════════════════════════════════════════
         TRADITIONS
         ═══════════════════════════════════════════ -->
    <section class="section traditions" id="traditions">
        <!-- Background: mycorrhizal network pattern -->
        <div class="section-bg" aria-hidden="true">
            <PatternNetwork />
        </div>

        <div class="container">
            <h2 class="section-title">Source Traditions</h2>
            <p class="section-subtitle">We draw from the deepest wells of human wisdom</p>

            <div class="traditions-tiers">
                <div class="tier">
                    <h3 class="tier-label">Core Canon</h3>
                    <p class="tier-desc">Deeply integrated, frequently revisited</p>
                    <div class="tradition-tags">
                        <span class="tag core">Buddhism</span>
                        <span class="tag core">Daoism</span>
                        <span class="tag core">Classical Greek & Roman Philosophy</span>
                        <span class="tag core">Judaism</span>
                        <span class="tag core">Indigenous North American</span>
                        <span class="tag core">Scientific Cosmology & Ecology</span>
                    </div>
                </div>

                <div class="tier">
                    <h3 class="tier-label">Incorporated Wisdom</h3>
                    <p class="tier-desc">Selectively drawn upon through key texts</p>
                    <div class="tradition-tags">
                        <span class="tag secondary">Sufism</span>
                        <span class="tag secondary">Christian Mysticism</span>
                        <span class="tag secondary">Shintoism</span>
                        <span class="tag secondary">Hindu Philosophy</span>
                        <span class="tag secondary">Norse & Celtic</span>
                        <span class="tag secondary">Confucianism</span>
                        <span class="tag secondary">Antifragility</span>
                    </div>
                </div>

                <div class="tier">
                    <h3 class="tier-label">Further Exploration</h3>
                    <p class="tier-desc">Pointers for deeper study — the canon is never closed</p>
                    <div class="tradition-tags">
                        <span class="tag tertiary">Aboriginal Australian</span>
                        <span class="tag tertiary">Polynesian</span>
                        <span class="tag tertiary">Indigenous South American</span>
                        <span class="tag tertiary">Mesoamerican</span>
                        <span class="tag tertiary">African Traditional</span>
                        <span class="tag tertiary">Jainism</span>
                        <span class="tag tertiary">Process Philosophy</span>
                        <span class="tag tertiary">Deep Ecology</span>
                        <span class="tag tertiary">& more…</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Separator: Traditions → Meta -->
    <SectionSeparator from="parchment" to="cream" path="M0,0 L1440,0 L1440,15 C1320,42 1080,8 840,28 C600,48 360,12 120,35 C40,42 0,30 0,30 Z" />

    <!-- ═══════════════════════════════════════════
         WHAT IS A RELIGION
         ═══════════════════════════════════════════ -->
    <section class="section meta" id="meta">
        <!-- Background: concentric sacred geometry -->
        <div class="section-bg" aria-hidden="true">
            <MetaBackdrop />
        </div>

        <div class="container narrow">
            <h2 class="section-title">What Is a Religion?</h2>
            <p class="section-subtitle">The abstract structure that Arbora consciously implements</p>

            <div class="meta-grid">
                <div class="meta-item">
                    <h4>Cosmology</h4>
                    <p>What is all of this?</p>
                </div>
                <div class="meta-item">
                    <h4>Orientation</h4>
                    <p>Where do I fit?</p>
                </div>
                <div class="meta-item">
                    <h4>Ethics</h4>
                    <p>How should I act?</p>
                </div>
                <div class="meta-item">
                    <h4>Practice</h4>
                    <p>What do I do?</p>
                </div>
                <div class="meta-item">
                    <h4>Community</h4>
                    <p>Who are my people?</p>
                </div>
                <div class="meta-item">
                    <h4>Meaning-Making</h4>
                    <p>Why does any of this matter?</p>
                </div>
                <div class="meta-item">
                    <h4>Aesthetic Experience</h4>
                    <p>What does this feel like?</p>
                </div>
                <div class="meta-item">
                    <h4>Temporal Structure</h4>
                    <p>What time is it, really?</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Separator: Meta → Footer (root-like edge) -->
    <SectionSeparator from="earth" to="parchment" tall path="M0,0 L1440,0 L1440,30 C1380,15 1320,35 1260,20 C1200,5 1140,40 1080,18 C1020,0 960,35 900,22 C840,8 780,38 720,20 C660,5 600,40 540,22 C480,5 420,35 360,18 C300,2 240,38 180,22 C120,6 60,35 0,20 Z" />

    </main>

    <!-- ═══════════════════════════════════════════
         FOOTER
         ═══════════════════════════════════════════ -->
<Fragment slot="footer-roots"><PatternRoots /></Fragment>
<p slot="footer-colophon" class="footer-text small">From Latin <em>arbor</em>: tree.</p>
</Base>
