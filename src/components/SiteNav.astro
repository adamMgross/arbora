---
import { navLinks, routes } from '../lib/routes';
---

<nav class="site-nav">
    <a href={routes.home.href} class="nav-mark">{routes.home.label}</a>
    <div class="nav-links">
        {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
    </div>
    <button class="nav-toggle" aria-label="Menu">&#9776;</button>
</nav>
