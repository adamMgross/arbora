{
  "name": "arbora",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run --project unit",
    "test:e2e": "playwright test --project=e2e --project=phone",
    "parity": "node tests/parity/run.mjs",
    "format:check": "prettier --no-error-on-unmatched-pattern --check 'tests/**/*.{ts,mjs}' 'src/**/*.css' 'src/**/*.ts' 'integrations/*.ts' 'scripts/*.mjs' '*.{json,mjs,ts}'",
    "quality": "npm run format:check && npm run check && npm test && npm run build && npm run verify:dist && npm run test:integration && npm run test:e2e",
    "test:integration": "vitest run --project integration",
    "build:parity": "SITE=https://arbora.site BASE_PATH=/ astro build",
    "verify:dist": "node scripts/verify-dist.mjs dist",
    "build:prod": "SITE=https://adammgross.github.io BASE_PATH=/arbora/ astro build",
    "verify:prod": "node scripts/verify-dist.mjs dist /arbora/",
    "test:e2e:prod": "E2E_BASE_PATH=/arbora/ playwright test --project=e2e --project=phone",
    "ci": "npm run quality && npm run build:prod && npm run verify:prod && npm run test:e2e:prod"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/mdx": "^8.1.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "astro": "^7.4.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
